# ローカル開発用の架空値。実際の値は `.env`（Git管理外）にコピーして使う:  cp .env.example .env
# 本番の値・実在の学生情報・実トークンをここやGitに入れない。本番のsecretは別の管理(P4)。

# PostgreSQL（ローカルのコンテナ専用）。パスワードはURLに埋め込むため、英数字と - _ . ~ だけにする。
POSTGRES_USER=nu_app
POSTGRES_DB=nu_app
POSTGRES_PASSWORD=local-dev-only-change-me

# ホスト側の公開ポート（すべて127.0.0.1にだけbindされる）
DB_PORT=15432
API_PORT=8080
WEB_PORT=8081
ADMIN_PORT=3000
