# /etc/nu_app/backup.env の雛形（本番では root・権限600。Git外に置く。値は環境に合わせて書く）。
# backup.sh・restore-verify.sh・deploy.sh・cert-check.sh が読む（systemdのEnvironmentFile、または deploy.sh が直接読み込む）。
# 手順: docs/SERVER_SETUP.md §6.2 / 運用: docs/RUNBOOK.md
BACKUP_ROOT=/srv/nu_app/backups
MEDIA_DIR=/srv/nu_app/media
COMPOSE_FILE=/srv/nu_app/infrastructure/compose.prod.yaml
COMPOSE_ENV_FILE=/srv/nu_app/.env
RETENTION=7
MIN_FREE_MB=1024
HOST_LABEL=nu_app
# Discordの運用チャンネルのWebhook URL（秘密。実際の値をここに書く。Gitに入れない）
BACKUP_NOTIFY_WEBHOOK_URL=
